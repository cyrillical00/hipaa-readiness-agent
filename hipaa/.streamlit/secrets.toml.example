# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Used for every Claude call: assessment analysis, roadmap generation,
# validator, fixer, and BAA outreach drafts. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = "sk-ant-..."

# ---------------------------------------------------------------------------
# Who may use the app
# ---------------------------------------------------------------------------

# Optional. When set, only these signed-in addresses get past the login gate.
# When left out, any account your identity provider signs in is admitted with
# the default role (viewer). The sign-in itself is configured in [auth] at the
# bottom of this file.
# allowed_emails = [
#     "REPLACE_WITH_USER_EMAIL",
# ]

# ---------------------------------------------------------------------------
# Optional GitHub-backed state storage
# ---------------------------------------------------------------------------

# If unset, per-user JSONL state falls back to .streamlit/state on local disk.
# Use a private repo. The PAT needs `repo` scope on that specific repo only,
# nothing else, no org access.
HIPAA_STATE_REPO = ""   # e.g. "cyrillical00/hipaa-state"
HIPAA_STATE_PAT  = ""   # GitHub PAT with repo scope on the state repo above

# ---------------------------------------------------------------------------
# Optional model overrides (defaults shown)
# ---------------------------------------------------------------------------

# Main generator model (assessment, roadmap, BAA drafts).
# CLAUDE_MAIN_MODEL  = "claude-sonnet-4-6"

# Light model used by the validator and fixer in the refine loop.
# CLAUDE_LIGHT_MODEL = "claude-haiku-4-5-20251001"

# ---------------------------------------------------------------------------
# Sign-in (required for any deployment other people can reach)
# ---------------------------------------------------------------------------

# The app admits nobody until an identity provider vouches for them. This is
# Streamlit's own OIDC sign-in (st.login); see
# https://docs.streamlit.io/develop/api-reference/user/st.login
# TOML tables must come last, so keep this section at the end of the file.
[auth]
redirect_uri = "REPLACE_WITH_APP_URL/oauth2callback"
cookie_secret = "REPLACE_WITH_LONG_RANDOM_STRING"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
